>    value            = *(TEXT-UTF8char / WSP)
>    TEXT-UTF8char    = <as defined in Section 20.1>
>    WSP              = <See RFC 5234> ; Space or HTAB
>    VCHAR            = <See RFC 5234>
>    CRLF             = <See RFC 5234>
>
>
